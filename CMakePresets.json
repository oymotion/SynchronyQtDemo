        },
        {
            "name": "qt-demo-mac",
            "configurePreset": "qt-demo-mac"
        },
        {
            "name": "qt-demo-mobile-preview",
            "configurePreset": "qt-demo-mobile-preview"
        },
        {
            "name": "qt-demo-linux",
            "configurePreset": "qt-demo-linux"
        },
        {
            "name": "qt-demo-linux-arm64",
            "configurePreset": "qt-demo-linux-arm64"
        },
        {
            "name": "qt-demo-ios",
            "configurePreset": "qt-demo-ios",
            "configuration": "Debug"
        },
        {
            "name": "qt-demo-android",
            "configurePreset": "qt-demo-android"
