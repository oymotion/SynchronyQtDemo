{
    "version": 3,
    "configurePresets": [
        {
            "name": "qt-demo",
            "displayName": "Qt Demo (VS2022 x64)",
            "generator": "Visual Studio 17 2022",
            "architecture": "x64",
            "binaryDir": "${sourceDir}/build",
            "cacheVariables": {
                "CMAKE_PREFIX_PATH": "D:/Qt/6.10.2/msvc2022_64"
            }
        },
        {
            "name": "qt-demo-x86",
            "displayName": "Qt Demo (VS2022 x86, 32-bit Qt kit)",
            "generator": "Visual Studio 17 2022",
            "architecture": "Win32",
            "binaryDir": "${sourceDir}/build_x86",
            "cacheVariables": {
                "CMAKE_PREFIX_PATH": "D:/Qt/6.10.2/msvc2022",
                "SENSOR_SDK_WIN_ARCH": "x86"
            }
        },
        {
            "name": "qt-demo-mac",
            "displayName": "Qt Demo (macOS)",
            "generator": "Unix Makefiles",
            "binaryDir": "${sourceDir}/build_mac",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Release",
                "CMAKE_PREFIX_PATH": "$env{HOME}/Qt/6.8.3/macos"
            }
        },
        {
            "name": "qt-demo-mac-xcode",
            "displayName": "Qt Demo (macOS, Xcode project)",
            "generator": "Xcode",
            "binaryDir": "${sourceDir}/build_xcode",
            "cacheVariables": {
                "CMAKE_PREFIX_PATH": "$env{HOME}/Qt/6.8.3/macos"
            }
        },
        {
            "name": "qt-demo-mobile-preview",
            "displayName": "Qt Demo (macOS, phone tab layout preview)",
            "generator": "Unix Makefiles",
            "binaryDir": "${sourceDir}/build_mobile_preview",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Release",
                "CMAKE_PREFIX_PATH": "$env{HOME}/Qt/6.8.3/macos",
                "DEMO_MOBILE_LAYOUT": "ON"
            }
        },
        {
            "name": "qt-demo-linux",
            "displayName": "Qt Demo (Linux x86_64; requires QT_LINUX_KIT env)",
            "generator": "Unix Makefiles",
            "binaryDir": "${sourceDir}/build_linux",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Release",
                "CMAKE_PREFIX_PATH": "$env{QT_LINUX_KIT}"
            }
        },
        {
            "name": "qt-demo-linux-arm64",
            "displayName": "Qt Demo (Linux arm64; requires QT_LINUX_KIT env)",
            "generator": "Unix Makefiles",
            "binaryDir": "${sourceDir}/build_linux_arm64",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Release",
                "CMAKE_PREFIX_PATH": "$env{QT_LINUX_KIT}",
                "SENSOR_SDK_LINUX_ARCH": "arm64"
            }
        },
        {
            "name": "qt-demo-ios",
            "displayName": "Qt Demo (iOS device; requires QT_IOS_KIT env)",
            "generator": "Xcode",
            "binaryDir": "${sourceDir}/build_ios",
            "cacheVariables": {
                "CMAKE_SYSTEM_NAME": "iOS",
                "CMAKE_PREFIX_PATH": "$env{QT_IOS_KIT}",
                "CMAKE_TOOLCHAIN_FILE": "$env{QT_IOS_KIT}/lib/cmake/Qt6/qt.toolchain.cmake",
                "DEMO_IOS_DEV_TEAM": "$env{DEMO_IOS_DEV_TEAM}"
            }
        },
        {
            "name": "qt-demo-android",
            "displayName": "Qt Demo (Android arm64; requires QT_ANDROID_KIT env)",
            "generator": "Ninja",
            "binaryDir": "${sourceDir}/build_android",
            "cacheVariables": {
                "CMAKE_TOOLCHAIN_FILE": "$env{QT_ANDROID_KIT}/lib/cmake/Qt6/qt.toolchain.cmake",
                "CMAKE_PREFIX_PATH": "$env{QT_ANDROID_KIT}",
                "ANDROID_ABI": "arm64-v8a",
                "ANDROID_PLATFORM": "android-28"
            }
        }
    ],
    "buildPresets": [
        {
            "name": "qt-demo-debug",
            "configurePreset": "qt-demo",
            "configuration": "Debug"
        },
        {
            "name": "qt-demo-release",
            "configurePreset": "qt-demo",
            "configuration": "Release"
        },
        {
